{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lepicurienne-by-waycha",
  "main": "worker/index.ts",
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_date": "2024-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } }
  ],
  "env": {
    "preview": {
      "name": "lepicurienne-by-waycha-preview",
      "workers_dev": true,
      "preview_urls": false,
      "ratelimits": [
        { "name": "CONTACT_LIMITER", "namespace_id": "2002", "simple": { "limit": 3, "period": 60 } }
      ],
      "vars": { "TURNSTILE_SITE_KEY": "1x00000000000000000000AA" }
    }
  }
}
